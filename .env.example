# Copy to .env for local runs (server.js loads it). On Vercel, set these in
# Project Settings -> Environment Variables instead.

# Postgres connection (Supabase on Vercel). POSTGRES_URL is also accepted.
DATABASE_URL=postgresql://karina@localhost:5432/ord_xplore

# Intent detection, tried in this order: CaISI -> Gemini -> OpenAI -> rule-based.
# Leave CAISI_URL unset on Vercel unless the service is publicly hosted.
# Locally, server.js defaults it to http://localhost:8001.
CAISI_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
# "llm" (default) or "heuristic" to skip all LLM calls.
ENGINE_MODE=llm

# Basic auth for the curation / upload APIs (middleware.js).
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

PORT=3000
